rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user profile
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check role
    function hasRole(role) {
      return isAuth() && userProfile().role == role;
    }

    // Helper: same company
    function sameCompany(companyId) {
      return isAuth() && userProfile().companyId == companyId;
    }

    // USERS — own profile or super admin
    match /users/{userId} {
      allow read:  if isAuth() && (request.auth.uid == userId || hasRole('superadmin') || sameCompany(resource.data.companyId));
      allow write: if isAuth() && (request.auth.uid == userId || hasRole('superadmin') || hasRole('company_admin'));
    }

    // COMPANIES — super admin only for write, company members for read
    match /companies/{companyId} {
      allow read:  if isAuth() && (hasRole('superadmin') || sameCompany(companyId));
      allow write: if isAuth() && (hasRole('superadmin') || (hasRole('company_admin') && sameCompany(companyId)));
    }

    // PATIENTS — company members only
    match /patients/{patientId} {
      allow read:  if isAuth() && (hasRole('superadmin') || sameCompany(resource.data.companyId));
      allow write: if isAuth() && (hasRole('superadmin') || hasRole('company_admin') || hasRole('billing_staff'));
    }

    // CLAIMS — company members can write, providers read only
    match /claims/{claimId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (hasRole('superadmin') || hasRole('company_admin') || hasRole('billing_staff'));
    }

    // PROVIDERS — company members only
    match /providers/{providerId} {
      allow read:  if isAuth() && (hasRole('superadmin') || sameCompany(resource.data.companyId));
      allow write: if isAuth() && (hasRole('superadmin') || hasRole('company_admin') || hasRole('billing_staff'));
    }

    // PAYMENTS — billing staff and above
    match /payments/{paymentId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (hasRole('superadmin') || hasRole('company_admin') || hasRole('billing_staff'));
    }

    // DENIALS — billing staff and above
    match /denials/{denialId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (hasRole('superadmin') || hasRole('company_admin') || hasRole('billing_staff'));
    }

    // DEMO REQUESTS — public write (contact form), super admin read
    match /demo_requests/{requestId} {
      allow read:  if isAuth() && hasRole('superadmin');
      allow write: if true;  // public contact form
    }
  }
}
