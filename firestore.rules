rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function signedUp() { return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedUp() ? userDoc().role : null; }
    function companyId() { return signedUp() ? userDoc().companyId : null; }
    function isSuperAdmin() { return isAuth() && role() == 'superadmin'; }
    function isCompanyAdmin() { return isAuth() && role() == 'company_admin'; }
    function isBillingStaff() { return isAuth() && role() == 'billing_staff'; }
    function canWrite() { return isAuth() && (isSuperAdmin() || isCompanyAdmin() || isBillingStaff()); }
    function sameCompany(cid) { return isAuth() && companyId() == cid; }

    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin() || sameCompany(resource.data.companyId));
      allow write: if isAuth() && (request.auth.uid == uid || isSuperAdmin() || isCompanyAdmin());
    }
    match /companies/{cid} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(cid));
      allow write: if isAuth() && (isSuperAdmin() || (signedUp() && isCompanyAdmin() && sameCompany(cid)));
      // Allow first-time company creation during signup (user doc doesn't exist yet)
      allow create: if isAuth() && !signedUp();
    }
    match /patients/{id} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      allow write: if canWrite();
    }
    match /claims/{id} {
      allow read: if isAuth();
      allow write: if canWrite();
    }
    match /claims/{id}/history/{entry} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(/databases/$(database)/documents/claims/$(id).data.companyId));
      allow create: if canWrite();
      allow update, delete: if isSuperAdmin();
    }
    match /providers/{id} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      allow write: if canWrite();
    }
    match /payments/{id} {
      allow read: if isAuth();
      allow write: if canWrite();
    }
    match /denials/{id} {
      allow read: if isAuth();
      allow write: if canWrite();
    }
    match /credentialing/{id} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      allow write: if canWrite();
    }
    match /documents/{id} {
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      allow write: if canWrite();
    }
    match /demo_requests/{id} {
      allow read: if isSuperAdmin();
      allow write: if true;
    }

    // ── Phase 4B: Notifications ──────────────────────────────────────────────
    match /notifications/{id} {
      // Any authenticated user in the same company can read
      allow read: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      // Any authenticated staff can create notifications
      allow create: if canWrite();
      // Users can mark their own notifications as read; admins can do anything
      allow update: if isAuth() && (isSuperAdmin() || sameCompany(resource.data.companyId));
      allow delete: if isAuth() && (isSuperAdmin() || isCompanyAdmin());
    }
  }
}
